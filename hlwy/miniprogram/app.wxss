/* app.wxss */

/* 全局样式重置 */
page, view, text, image, button, input, textarea, navigator, picker {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

page {
  font-size: 14px;
  color: #333;
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 公共样式 */
.container {
  padding: 16rpx;
  min-height: 100vh;
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin: 16rpx 0;
}

.btn-primary {
  background-color: #07c160;
  color: #fff;
}

.btn-secondary {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #e0e0e0;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 输入框样式 */
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin-bottom: 16rpx;
  background-color: #fff;
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 描述样式 */
.desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 价格样式 */
.price {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff4d4f;
}

/* 距离标签样式 */
.distance-tag {
  font-size: 24rpx;
  color: #07c160;
  background-color: #f0fff4;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
}

/* 场景标签样式 */
.scene-tag {
  font-size: 24rpx;
  color: #1890ff;
  background-color: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
}