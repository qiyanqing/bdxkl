/* index.wxss */
/* 文件路径：pages/index/index.wxss */
/* 功能描述：首页物品列表页面样式，温暖邻里风格设计 */
/* 创建日期：2026-01-28 */
/* 版本：3.0.0 */

/* ==================== 设计变量 ==================== */
page {
  --primary-color: #07c160;
  --primary-light: #d9f7be;
  --primary-gradient: linear-gradient(135deg, #07c160 0%, #52c41a 100%);
  --text-primary: #1a1a1a;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --bg-page: #f7f8f7;
  --bg-card: #ffffff;
  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(7, 193, 96, 0.08);
  --shadow-lg: 0 12rpx 32rpx rgba(7, 193, 96, 0.12);
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
}

.container {
  padding: 24rpx;
  background: linear-gradient(180deg, #f0fdf4 0%, #f7f8f7 100%);
  min-height: 100vh;
  position: relative;
}

/* ==================== 搜索栏（新增毛玻璃效果） ==================== */
.search-bar {
  display: flex;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: var(--radius-xl);
  padding: 12rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 100;
  border: 1rpx solid rgba(7, 193, 96, 0.1);
}

.search-input-wrapper {
  flex: 1;
  position: relative;
}

.search-input-wrapper::before {
  content: '🔍';
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  opacity: 0.5;
}

.search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx 0 64rpx;
  border: none;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.search-input:focus {
  background: #fff;
  box-shadow: 0 0 0 2rpx var(--primary-light);
}

.search-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-left: 16rpx;
  background: var(--primary-gradient);
  color: #fff;
  border: none;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  padding: 0;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
}

.search-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.3);
}

/* ==================== 搜索面板（优化动画） ==================== */
.search-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(4rpx);
  z-index: 95;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.search-panel {
  position: absolute;
  top: calc(100% + 8rpx);
  left: 0;
  right: 0;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 0;
  box-shadow: var(--shadow-lg);
  z-index: 99;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.search-panel.show {
  max-height: 600rpx;
  padding: 32rpx;
  overflow-y: auto;
}

.search-section {
  margin-bottom: 32rpx;
}

.search-section:last-child {
  margin-bottom: 0;
}

.search-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.search-section-clear {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: var(--radius-sm);
}

.search-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.search-tag {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  border-radius: var(--radius-xl);
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.search-tag:active {
  transform: scale(0.95);
}

.search-tag.hot {
  background: linear-gradient(135deg, #fff1f0 0%, #ffccc7 100%);
  color: #ff4d4f;
  border-color: rgba(255, 77, 79, 0.2);
}

.hot-icon {
  margin-right: 6rpx;
}

/* ==================== 筛选栏（优化视觉） ==================== */
.filter-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 0 8rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.filter-item {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: all 0.3s ease;
}

.filter-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

/* ==================== 排序栏 + 筛选按钮 ==================== */
.sort-bar {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 0 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.sort-item {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: all 0.3s ease;
}

.sort-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.sort-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
}

.filter-btn {
  width: 120rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-weight: 500;
  transition: all 0.3s ease;
}

.filter-btn:active {
  background: var(--primary-light);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
}

.filter-icon {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  background: #ff4d4f;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.1); }
}

/* ==================== 筛选面板 ==================== */
.filter-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4rpx);
  z-index: 200;
  animation: fadeIn 0.2s ease;
}

.filter-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.filter-panel.show {
  transform: translateY(0);
}

.filter-panel-content {
  flex: 1;
  padding: 40rpx 32rpx 24rpx;
  overflow-y: auto;
}

.filter-group {
  margin-bottom: 48rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid var(--primary-color);
}

.filter-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-chip {
  padding: 18rpx 32rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  border-radius: var(--radius-xl);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.filter-chip:active {
  transform: scale(0.95);
}

.filter-chip.active {
  background: var(--primary-light);
  color: var(--primary-color);
  border-color: var(--primary-color);
  font-weight: 500;
}

.price-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.price-input:focus {
  background: #fff;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 4rpx var(--primary-light);
}

.price-separator {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  background: var(--bg-card);
}

.filter-action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  text-align: center;
  border: none;
  font-weight: 500;
  transition: all 0.3s ease;
}

.filter-action-btn:active {
  transform: scale(0.97);
}

.filter-action-btn.reset {
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  color: var(--text-secondary);
}

.filter-action-btn.confirm {
  background: var(--primary-gradient);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* ==================== 商品列表（优化卡片设计） ==================== */
.goods-list {
  background: transparent;
}

.goods-item {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  padding: 16rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.goods-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--primary-gradient);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.goods-item:active::before {
  opacity: 1;
}

.goods-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.goods-image {
  width: 220rpx;
  height: 220rpx;
  margin-right: 20rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
}

.goods-image image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.goods-item:active .goods-image image {
  transform: scale(1.05);
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 4rpx 0;
}

.goods-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.goods-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  gap: 8rpx;
}

.stats-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.goods-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
  margin-top: auto;
  letter-spacing: -0.5rpx;
}

.stat-item {
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  border-radius: var(--radius-sm);
}
