<!-- index.wxml -->
<!-- 文件路径：pages/index/index.wxml -->
<!-- 功能描述：首页物品列表页面结构，包含搜索面板 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <input placeholder="搜索闲置物品" class="search-input" bindinput="onSearchInput" bindfocus="onSearchFocus" bindconfirm="onSearch" value="{{searchKeyword}}" />
    </view>
    <button bindtap="onSearch" class="search-btn">搜索</button>
  </view>

  <!-- 搜索面板（历史搜索 & 热门搜索） -->
  <view class="search-panel-mask" wx:if="{{showSearchPanel}}" bindtap="onCloseSearchPanel"></view>
  <view class="search-panel {{showSearchPanel ? 'show' : ''}}" catchtap="onSearchPanelTap">
    <!-- 历史搜索 -->
    <view class="search-section" wx:if="{{searchHistory.length > 0}}">
      <view class="search-section-header">
        <text class="search-section-title">历史搜索</text>
        <text class="search-section-clear" bindtap="clearSearchHistory">清除</text>
      </view>
      <view class="search-tags">
        <block wx:for="{{searchHistory}}" wx:key="index">
          <view class="search-tag" bindtap="onSearchTagTap" data-keyword="{{item}}">{{item}}</view>
        </block>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="search-section">
      <view class="search-section-header">
        <text class="search-section-title">热门搜索</text>
      </view>
      <view class="search-tags">
        <block wx:for="{{hotSearchKeywords}}" wx:key="index">
          <view class="search-tag {{index < 3 ? 'hot' : ''}}" bindtap="onSearchTagTap" data-keyword="{{item}}">
            <text wx:if="{{index < 3}}" class="hot-icon">🔥</text>{{item}}
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{activeScene === 'all' ? 'active' : ''}}" bindtap="onSceneChange" data-scene="all">
      全部
    </view>
    <view class="filter-item {{activeScene === 'community' ? 'active' : ''}}" bindtap="onSceneChange" data-scene="community">
      社区
    </view>
    <view class="filter-item {{activeScene === 'office' ? 'active' : ''}}" bindtap="onSceneChange" data-scene="office">
      园区
    </view>
  </view>

  <!-- 排序栏 + 筛选按钮 -->
  <view class="sort-bar">
    <view class="sort-item {{activeSort === 'latest' ? 'active' : ''}}" bindtap="onSortChange" data-sort="latest">
      最新
    </view>
    <view class="sort-item {{activeSort === 'nearest' ? 'active' : ''}}" bindtap="onSortChange" data-sort="nearest">
      最近
    </view>
    <view class="filter-btn" bindtap="onShowFilter">
      <text>筛选</text>
      <text class="filter-icon" wx:if="{{activeCategory || activeCondition || minPrice || maxPrice}}">●</text>
    </view>
  </view>

  <!-- 筛选面板遮罩 -->
  <view class="filter-panel-mask" wx:if="{{showFilterPanel}}" bindtap="onCloseFilter"></view>

  <!-- 筛选面板 -->
  <view class="filter-panel {{showFilterPanel ? 'show' : ''}}">
    <view class="filter-panel-content">
      <!-- 分类筛选 -->
      <view class="filter-group">
        <view class="filter-group-title">商品分类</view>
        <view class="filter-grid">
          <block wx:for="{{categories}}" wx:key="id">
            <view class="filter-chip {{activeCategory === item.id ? 'active' : ''}}" bindtap="onCategorySelect" data-category="{{item.id}}">
              {{item.name}}
            </view>
          </block>
        </view>
      </view>

      <!-- 成色筛选 -->
      <view class="filter-group">
        <view class="filter-group-title">新旧程度</view>
        <view class="filter-grid">
          <block wx:for="{{conditions}}" wx:key="id">
            <view class="filter-chip {{activeCondition === item.id ? 'active' : ''}}" bindtap="onConditionSelect" data-condition="{{item.id}}">
              {{item.name}}
            </view>
          </block>
        </view>
      </view>

      <!-- 价格区间 -->
      <view class="filter-group">
        <view class="filter-group-title">价格区间（元）</view>
        <view class="price-range">
          <input class="price-input" placeholder="最低价" type="digit" bindinput="onPriceInput" data-field="minPrice" value="{{minPrice}}" />
          <text class="price-separator">-</text>
          <input class="price-input" placeholder="最高价" type="digit" bindinput="onPriceInput" data-field="maxPrice" value="{{maxPrice}}" />
        </view>
      </view>
    </view>

    <!-- 筛选操作按钮 -->
    <view class="filter-actions">
      <button class="filter-action-btn reset" bindtap="onResetFilter">重置</button>
      <button class="filter-action-btn confirm" bindtap="onApplyFilter">确定</button>
    </view>
  </view>

  <!-- 物品列表 -->
  <view class="goods-list">
    <block wx:for="{{goodsList}}" wx:key="_id">
      <view class="goods-item" bindtap="onGoodsTap" data-id="{{item._id}}">
        <view class="goods-image">
          <image src="{{item.images[0]}}" mode="aspectFill" />
        </view>
        <view class="goods-info">
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-desc">{{item.description}}</view>
          <view class="goods-tags">
            <text class="distance-tag">{{item.distanceRange}}</text>
            <view class="stats-tags">
              <text class="stat-item" wx:if="{{item.viewCount > 0}}">{{item.viewCount}}人看过</text>
              <text class="stat-item" wx:if="{{item.chatCount > 0}}">{{item.chatCount}}人聊过</text>
              <text class="stat-item" wx:if="{{item.collectCount > 0}}">{{item.collectCount}}人收藏</text>
            </view>
          </view>
          <view class="goods-price">{{item.price === 0 ? '免费' : '¥' + item.price}}</view>
        </view>
      </view>
    </block>
  </view>
</view>