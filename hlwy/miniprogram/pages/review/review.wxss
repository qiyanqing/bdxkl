/* review.wxss */
/* 文件路径：pages/review/review.wxss */
/* 功能描述：评价页面样式 */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 商品信息 */
.goods-info {
  display: flex;
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

/* 评分区域 */
.rating-section {
  background-color: #fff;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 24rpx;
}

.rating-stars {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.star {
  font-size: 72rpx;
  color: #ddd;
}

.star.active {
  color: #ffb400;
}

.rating-text {
  font-size: 26rpx;
  color: #666;
}

/* 标签选择 */
.tags-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.tag.active {
  background-color: #fff1f0;
  color: #ff4d4f;
  border-color: #ff4d4f;
}

/* 评价内容 */
.content-section {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.content-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.submit-btn[disabled] {
  background-color: #ccc;
}
