/* published.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  background-color: #fff;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  width: 28rpx;
  height: 28rpx;
  transform: rotate(180deg);
}

.header-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.header-right {
  width: 80rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background-color: #fff;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  gap: 24rpx;
}

.filter-item {
  font-size: 28rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background-color: #f5f5f5;
  cursor: pointer;
}

.filter-item.active {
  color: #fff;
  background-color: #07c160;
}

/* 物品列表 */
.goods-list {
  background-color: #f5f5f5;
  padding: 0 16rpx;
}

/* 物品项 */
.goods-item {
  display: flex;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.goods-image {
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.distance-tag {
  background-color: #f0fff4;
  color: #07c160;
}

.status-tag {
  background-color: #fff7e6;
  color: #faad14;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.stats-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.publish-btn {
  width: 200rpx;
  height: 72rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  line-height: 72rpx;
  padding: 0;
}

.publish-btn::after {
  border: none;
}