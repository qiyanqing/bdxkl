/* user.wxss */
/* 文件路径：pages/user/user.wxss */
/* 功能描述：个人中心页面样式，温暖邻里风格设计 */
/* 创建日期：2026-01-28 */
/* 版本：3.0.0 */

/* ==================== 设计变量 ==================== */
page {
  --primary-color: #07c160;
  --primary-light: #d9f7be;
  --primary-gradient: linear-gradient(135deg, #07c160 0%, #52c41a 100%);
  --text-primary: #1a1a1a;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --bg-page: #f7f8f7;
  --bg-card: #ffffff;
  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(7, 193, 96, 0.08);
  --shadow-lg: 0 12rpx 32rpx rgba(7, 193, 96, 0.12);
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
}

.container {
  background: linear-gradient(180deg, #f0fdf4 0%, #f7f8f7 100%);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ==================== 用户信息区域（适配现有WXML） ==================== */
.user-info {
  display: flex;
  align-items: center;
  padding: 60rpx 24rpx 40rpx;
  background: var(--primary-gradient);
  position: relative;
  overflow: hidden;
}

.user-info::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.user-info::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  margin-right: 24rpx;
  position: relative;
  z-index: 1;
}

.user-detail {
  flex: 1;
  color: #fff;
  position: relative;
  z-index: 1;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.points {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 编辑按钮 */
.edit-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.edit-btn image {
  width: 32rpx;
  height: 32rpx;
}

/* 登录按钮 */
.login-btn {
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8rpx);
  border-radius: var(--radius-xl);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* ==================== 功能菜单区域 ==================== */
.menu-section {
  background: var(--bg-card);
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-count {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-right: 8rpx;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: var(--radius-sm);
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}

/* ==================== 地址管理区域 ==================== */
.address-section {
  background: var(--bg-card);
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.address-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.address-item:last-child {
  border-bottom: none;
}

.address-info {
  flex: 1;
}

.address-type {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.address-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.add-address-btn,
.manage-address-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin-top: 20rpx;
  border: 2rpx dashed var(--primary-color);
  border-radius: var(--radius-lg);
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.manage-address-btn {
  border-style: solid;
  border-color: #f0f0f0;
  color: var(--text-secondary);
}

.add-address-btn:active {
  background: var(--primary-light);
}

.manage-address-btn:active {
  background: #f9f9f9;
}

.add-address-btn image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

/* ==================== 设置区域 ==================== */
.settings-section {
  background: var(--bg-card);
  margin: 0 24rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.settings-section .menu-item {
  border-bottom: 1rpx solid #f5f5f5;
}

.settings-section .menu-item:last-child {
  border-bottom: none;
}

/* ==================== 退出登录 ==================== */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #ff4d4f;
  font-size: 30rpx;
  font-weight: 500;
  transition: background 0.2s ease;
}

.logout-btn:active {
  background: #fff5f5;
}

/* ==================== 登录弹窗 ==================== */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4rpx);
  z-index: 999;
  animation: fadeIn 0.2s ease;
}

.login-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: var(--radius-xl);
  padding: 40rpx;
  z-index: 1000;
  animation: slideUp 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    transform: translate(-50%, -40%);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%);
    opacity: 1;
  }
}

.login-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.login-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.login-modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--text-tertiary);
}

/* 头像选择区域 */
.avatar-section {
  margin-bottom: 40rpx;
}

.section-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.avatar-choose-btn,
.avatar-selected {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  border-radius: var(--radius-lg);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.avatar-choose-btn:active,
.avatar-selected:active {
  border-color: var(--primary-color);
  background: var(--primary-light);
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.avatar-preview.selected {
  border: 4rpx solid var(--primary-color);
}

.choose-hint,
.change-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 昵称输入区域 */
.nickname-section {
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  border: 2rpx solid transparent;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.nickname-input:focus {
  background: #fff;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 4rpx var(--primary-light);
}

/* 登录按钮 */
.confirm-login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary-gradient);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-xl);
  border: none;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
}

.confirm-login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.confirm-login-btn[disabled] {
  background: #ddd;
  color: #999;
  box-shadow: none;
}

.login-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}
