/* edit.wxss */

/* 容器样式 */
.container {
  padding: 16rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 章节样式 */
.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 章节标题 */
.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 地址类型选择 */
.radio-group {
  display: flex;
  gap: 48rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  color: #333;
  cursor: pointer;
}

radio {
  transform: scale(1.2);
}

radio .wx-radio-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  background-color: #fff;
}

radio .wx-radio-input.wx-radio-input-checked {
  border-color: #07c160;
  background-color: #07c160;
}

radio .wx-radio-input::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  background-color: #fff;
  border-radius: 50%;
  opacity: 0;
  transition: all 0.3s;
}

radio .wx-radio-input.wx-radio-input-checked::before {
  opacity: 1;
}

/* 地址类型显示 */
.address-type-display {
  display: inline-block;
  padding: 12rpx 32rpx;
  background-color: #f0fff4;
  color: #07c160;
  border: 1rpx solid #c3e6cb;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

/* 地址选择按钮 */
.location-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  color: #07c160;
  border: 1rpx solid #07c160;
  background-color: #f0fff4;
  border-radius: 8rpx;
  padding: 0 24rpx;
  transition: all 0.3s;
}

.location-btn:active {
  background-color: #e6f7ed;
  transform: scale(0.98);
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  vertical-align: middle;
  margin-right: 8rpx;
}

/* 定位提示 */
.location-tip {
  margin-top: 16rpx;
  padding: 16rpx;
  background-color: #fff3cd;
  border: 1rpx solid #ffeeba;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #856404;
}

.tip-text {
  line-height: 1.5;
}

/* 输入框样式 */
.section input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  background-color: #fafafa;
  transition: all 0.3s;
}

.section input:focus {
  background-color: #fff;
  border-color: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.1);
}

.input-placeholder {
  color: #999;
}

/* 已选择地址信息 */
.selected-address {
  background-color: #f0fff4;
  border: 1rpx solid #c3e6cb;
  border-radius: 8rpx;
  padding: 20rpx;
}

.address-name {
  font-size: 30rpx;
  color: #07c160;
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 默认地址开关 */
.switch-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

switch {
  transform: scale(1.2);
}

/* 保存按钮 */
.save-btn {
  margin: 32rpx 0 80rpx;
  height: 88rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s;
}

.save-btn:active {
  background-color: #06ad56;
  box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.2);
  transform: scale(0.98);
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 6rpx;
  height: 6rpx;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: #999;
}
